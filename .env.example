# Copy to .env.local for local development. On Render, enter the same names in
# the service's Environment settings instead (see DEPLOY.md). Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres. Local Docker: postgres://requisor:<password>@localhost:5433/requisor
# Supabase: the "Session pooler" connection string (Project → Connect).
DATABASE_URL=
# Set to "require" for Supabase or any hosted Postgres; leave unset locally.
# DATABASE_SSL=require
# Optional: Supabase's CA certificate (PEM), to verify the server certificate too.
# DATABASE_CA_CERT=

# Signs login sessions and encrypts stored tokens. Any long random string.
NEXTAUTH_SECRET=
# The site's public address. Not needed on Render (detected) unless you use a custom domain.
# NEXTAUTH_URL=https://learning.example.com

# xAI (Grok): the AI assistant, quizzes and practice assignments.
XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# ── Email (required in production) ──────────────────────────────────────────
# One email service. Without it, production cannot send verification or reset
# emails; in local development the links are printed to the server log.
# BREVO_API_KEY=
# ...or Resend instead:
# RESEND_API_KEY=
# A sender that service has verified.
# EMAIL_FROM=Requisor Learning <support@your-domain.com>

# Local development only: the test learner behind the "Use development student
# access" button on the login page. Ignored in production.
# DEV_STUDENT_EMAIL=student@requisor.local
# DEV_STUDENT_PASSWORD=

# One-click "Log in as test student / test tutor" buttons, no password. On in
# local development and on Vercel until you set this to off. They let anyone
# in as those accounts: set TEST_LOGINS=off before real users arrive.
# TEST_LOGINS=off

# Testing only: let new accounts log in without verifying their email (no
# email is sent). Remove before real users arrive.
# SKIP_EMAIL_VERIFICATION=on

# ── Optional ────────────────────────────────────────────────────────────────
# Database connections the app may open (default 20). Keep at 10 on Supabase.
# PG_POOL_MAX=10

# "Continue with Google" sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The AI assistant's spoken voice (ElevenLabs). Without a key it uses the browser's voice.
# ELEVENLABS_API_KEY=
# One line per voice character learners can pick; the name after VOICE_ID_ is shown
# in the picker (IVANNA -> "Ivanna", UNCLE_SAM -> "Uncle Sam"). Values are voice IDs
# from the ElevenLabs voice library.
# ELEVENLABS_VOICE_ID_IVANNA=
# ELEVENLABS_VOICE_ID_MARCUS=
# Optional: which character speaks until the learner picks one, and the model.
# ELEVENLABS_DEFAULT_VOICE=ivanna
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Auto-edit lesson recordings (Auphonic). Without a key the wizard runs a demo.
# AUPHONIC_API_KEY=
# Subtitles need a paid Auphonic plan.
# AUPHONIC_SUBTITLES=on
# Only when the site runs on Vercel, which can't take large uploads: the https
# address of a copy of this app on a host that can (e.g. Render). Recordings
# for tidy-up are uploaded there. Both copies need the same NEXTAUTH_SECRET,
# DATABASE_URL and AUPHONIC_API_KEY.
# RECORDING_UPLOAD_URL=https://your-app.onrender.com
# Show the simulated tidy-up on a live site (it is on by default only in development).
# VIDEO_EDIT_DEMO=on

# Post edited videos to the tutor's YouTube channel (off: tutors upload themselves).
# VIDEO_DELIVERY=youtube
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Cloudflare Turnstile on sign-up/login forms.
# TURNSTILE_ENABLED=true
# NEXT_PUBLIC_TURNSTILE_ENABLED=true
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
