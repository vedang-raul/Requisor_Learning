[userenv.production]
NEXTAUTH_URL = "https://learning.requisor.io"
TEST_LOGINS = "off"
TUTOR_TEST_LOGIN = "on"
PUBLIC_TEST_LOGINS = "on"

[userenv.development]
PUBLIC_TEST_LOGINS = "on"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
